# ==========================================
# Interview Prep Kit Generator - Environment Variables
# ==========================================

# LLM Provider API Keys (OpenAI / Gemini / Groq / Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Google Gemini or Groq alternative
GEMINI_API_KEY=
GROQ_API_KEY=

# MongoDB Connection String (Optional: falls back to in-memory store for instant local testing)
MONGODB_URI=mongodb://localhost:27017/interview_prep_db

# JWT Secret for Session Authentication
JWT_SECRET=super_secret_jwt_key_interview_prep_2026

# Web App Port / Base URL
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
